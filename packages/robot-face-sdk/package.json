{
  "name": "@robot-face/sdk",
  "version": "0.1.0",
  "description": "Core domain model and robot adapters for facial expression control",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/ws": "^8.5.13",
    "vitest": "^2.1.8",
    "ws": "^8.18.0"
  },
  "files": [
    "dist"
  ]
}
