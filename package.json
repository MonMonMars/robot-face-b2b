{
  "name": "robot-face-b2b",
  "type": "module",
  "private": true,
  "version": "0.1.0",
  "description": "B2B SDK and control surface for robot facial expressions",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @robot-face/sdk && npm run build -w @robot-face/stream-server && npm run build -w @robot-face/demo-cli && npm run build -w @robot-face/demo-web",
    "stream:server": "npm run start -w @robot-face/stream-server",
    "test": "npm run test -w @robot-face/sdk",
    "test:integration": "npm run test:integration -w @robot-face/sdk",
    "lint": "eslint \"packages/**/*.ts\" \"apps/**/*.ts\"",
    "demo:cli": "npm run start -w @robot-face/demo-cli",
    "demo:web": "npm run start -w @robot-face/demo-web"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2"
  },
  "engines": {
    "node": ">=20"
  }
}
